#!/bin/sh
# Writes the secret files chezmoi deliberately does not manage, from Bitwarden secure notes,
# then makes sure gh is authenticated and this host's ssh key is on GitHub. Idempotent.
#
#   bw item                   -> file (0600)
#   dotfiles/zsh_secrets      -> ~/.zsh_secrets
#   dotfiles/aws_env          -> ~/.aws_env
#   dotfiles/bedrock_env      -> ~/.bedrock_env
#   dotfiles/npmrc            -> ~/.npmrc
#   dotfiles/ssh_config_rojo  -> ~/.ssh/config.rojo
#   dotfiles/gh_token (login item, password) -> gh auth login --with-token
#   dotfiles/gpg-523CE7AD (attachments secret.asc, ownertrust.txt) -> gpg --import (if the key is missing)
#
# Needs an unlocked vault: export BW_SESSION=$(bw unlock --raw)
# DOTFILES_SKIP_SSH_KEY_UPLOAD=1 leaves GitHub's ssh key list alone (tests).
set -u

log()  { printf '[secrets] %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

for t in bw jq; do have "$t" || { log "$t is not installed"; exit 1; }; done

if [ "$(bw status 2>/dev/null | jq -r .status)" != "unlocked" ]; then
  log "Bitwarden is not unlocked. Run:  export BW_SESSION=\$(bw unlock --raw)"
  exit 1
fi
bw sync >/dev/null 2>&1 || log "bw sync failed, using the local cache"

changed=0 missing=0

# write_note <item name> <target path>
write_note() {
  item="$1" target="$2"
  notes="$(bw get item "$item" 2>/dev/null | jq -r '.notes // empty')"
  if [ -z "$notes" ]; then
    log "MISSING: Bitwarden secure note '$item' (keeping $target as it is)"
    missing=$((missing + 1))
    return
  fi
  mkdir -p "$(dirname "$target")"
  tmp="$(mktemp)"
  printf '%s\n' "$notes" > "$tmp"
  if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    chmod 600 "$target"
    log "unchanged $target"
  else
    install -m 600 "$tmp" "$target"
    rm -f "$tmp"
    log "wrote     $target"
    changed=$((changed + 1))
  fi
}

# GPG signing key (the chezmoi run_once script does this on the first apply; here it is retried)
GPG_KEY=523CE7AD
if have gpg && ! gpg --list-secret-keys "$GPG_KEY" >/dev/null 2>&1; then
  gid="$(bw get item "dotfiles/gpg-$GPG_KEY" 2>/dev/null | jq -r '.id // empty')"
  if [ -z "$gid" ]; then
    log "MISSING: Bitwarden item 'dotfiles/gpg-$GPG_KEY' (signing key not imported)"
    missing=$((missing + 1))
  else
    mkdir -p "$HOME/.gnupg" && chmod 700 "$HOME/.gnupg"
    if bw get attachment secret.asc --itemid "$gid" --raw | gpg --quiet --batch --import; then
      bw get attachment ownertrust.txt --itemid "$gid" --raw | gpg --quiet --batch --import-ownertrust 2>/dev/null || true
      log "imported gpg key $GPG_KEY"
      changed=$((changed + 1))
    else
      log "MISSING: attachment secret.asc on 'dotfiles/gpg-$GPG_KEY' (gpg import failed)"
      missing=$((missing + 1))
    fi
  fi
fi

write_note dotfiles/zsh_secrets     "$HOME/.zsh_secrets"
write_note dotfiles/aws_env         "$HOME/.aws_env"
write_note dotfiles/bedrock_env     "$HOME/.bedrock_env"
write_note dotfiles/npmrc           "$HOME/.npmrc"
write_note dotfiles/ssh_config_rojo "$HOME/.ssh/config.rojo"
[ -d "$HOME/.ssh" ] && chmod 700 "$HOME/.ssh"

# GitHub CLI
if have gh; then
  if gh auth status >/dev/null 2>&1; then
    log "gh already authenticated"
  else
    token="$(bw get password dotfiles/gh_token 2>/dev/null || true)"
    if [ -n "$token" ]; then
      if printf '%s' "$token" | gh auth login --with-token; then
        log "gh authenticated from dotfiles/gh_token"
        changed=$((changed + 1))
      else
        log "gh auth login failed"
      fi
    else
      log "MISSING: Bitwarden login item 'dotfiles/gh_token' (gh stays unauthenticated)"
      missing=$((missing + 1))
    fi
  fi
  if gh auth status >/dev/null 2>&1; then
    # no `gh auth setup-git` here: the credential helper lives in the managed .gitconfig template
    pub="$HOME/.ssh/id_ed25519.pub"
    if [ -f "$pub" ] && [ "${DOTFILES_SKIP_SSH_KEY_UPLOAD:-0}" != 1 ]; then
      keybody="$(awk '{print $2}' "$pub")"
      if ! gh ssh-key list 2>/dev/null | grep -qF "$keybody"; then
        log "adding this host's ssh key to GitHub as $(hostname -s)"
        gh ssh-key add "$pub" --title "$(hostname -s)" || log "gh ssh-key add failed (token needs admin:public_key)"
      fi
    fi
  fi
else
  log "gh not installed, skipping GitHub auth"
fi

log "done: $changed changed, $missing missing"
[ "$missing" -eq 0 ]
