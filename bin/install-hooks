#!/bin/sh
# Installs the pre-commit secret scan: pre-commit framework when available, else the plain git hook.
set -eu
cd "$(dirname "$0")/.."
if command -v pre-commit >/dev/null 2>&1; then
  pre-commit install
  echo "pre-commit installed (.pre-commit-config.yaml)"
else
  git config core.hooksPath .githooks
  echo "core.hooksPath = .githooks (gitleaks protect --staged when gitleaks is installed)"
fi
