# vim:set ft=tmux:
# ~/.tmux.conf — managed by chezmoi (`tmuxconfig`)
#--- Core
# Set prefix to Ctrl-a
unbind C-b
set -g prefix C-a
bind C-a send-prefix
set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.config/tmux/plugins/"

#--- Global base config
set -g default-terminal "tmux-256color"
set -g allow-passthrough on
set -s extended-keys on
set -g aggressive-resize on
set -sg escape-time 50  # >10: the OSC 10/11 colour replies tmux requests on attach arrive chunked over ssh and leaked into the pane as "11;rgb:..."
set -g history-limit 100000
set -g mouse on
set -g @yank_with_mouse on

#--- Windows Management
set -g base-index 1
set -g renumber-windows on
set-window-option -g pane-base-index 1
set-window-option -g mode-keys vi

# Window renaming
set-window-option -g automatic-rename on
set-option -g automatic-rename-format '#{?#{m:ssh*,#{pane_current_command}},#{s/.*@//;s/:.*//;s/\..*//;s/ .*//;s/^$/#{host_short}/:#{pane_title}},#{host_short}}'

# Allow programs to set window titles
set-option -g set-titles on
set-option -g set-titles-string '#h: #W'

# Update window title when SSH'ing
set-option -g allow-rename on


# --- Binds
unbind n
unbind w
bind n command-prompt "rename-window '%%'"
bind w new-window -c "#{pane_current_path}"
bind -n M-j previous-window
bind -n M-k next-window
bind -n C-M-Left previous-window
bind -n C-M-Right next-window
bind Space last-window
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind x kill-pane
bind N command-prompt -p "Pane title:" "select-pane -T '%%'"
bind S command-prompt -p "Swap with pane:" "swap-pane -t '%%'"
bind M run-shell 'if [ $(tmux list-panes -F "##{pane_left}" | sort -u | wc -l) -eq 1 ]; then tmux select-layout even-horizontal; else tmux select-layout even-vertical; fi'
bind Z resize-pane -x 70% -y 70%
bind -r S-Left run-shell 'tmux resize-pane -L $(($(tmux display-message -p "#{window_width}") / 10))'
bind -r S-Right run-shell 'tmux resize-pane -R $(($(tmux display-message -p "#{window_width}") / 10))'
bind -r S-Up run-shell 'tmux resize-pane -U $(($(tmux display-message -p "#{window_height}") / 10))'
bind -r S-Down run-shell 'tmux resize-pane -D $(($(tmux display-message -p "#{window_height}") / 10))'
bind P display-panes \; display-menu -x P -y P -T "Pane Actions" \
  "Flip orientation"     f "run-shell 'if [ $(tmux list-panes -F \"##{pane_left}\" | sort -u | wc -l) -eq 1 ]; then tmux select-layout even-horizontal; else tmux select-layout even-vertical; fi'" \
  "Even out all panes"   e "select-layout -E" \
  "Swap with..."         s "command-prompt -p 'Swap with pane:' 'swap-pane -t %%'" \
  "Break to new window"  b "break-pane" \
  "Join marked here (H)" h "join-pane -h" \
  "Join marked here (V)" v "join-pane -v"
bind r 'source-file "~/.tmux.conf"'
bind Tab next-window
bind BTab previous-window
#bind-key / copy-mode; send-key ? # Copy mode with /
#bind y setw synchronize-panes # Sync panes
#bind \` switch-client -t'{marked}' # Switch to marked

# Paste with 'p'
unbind p
bind p paste-buffer

#--- Status bar
set -g status-interval 5
set -g status-position top
# Hide this bar while the active pane runs ssh/mosh, so a nested remote tmux shows only its own
# (window/pane switches here; ssh start/exit is caught by the zsh hooks in ~/.zsh_functions)
set-hook -g session-window-changed 'if -F "#{||:#{m:ssh*,#{pane_current_command}},#{m:mosh*,#{pane_current_command}}}" "set status off" "set status on"'
set-hook -g window-pane-changed    'if -F "#{||:#{m:ssh*,#{pane_current_command}},#{m:mosh*,#{pane_current_command}}}" "set status off" "set status on"'
set -g status-left ""
set -g status-right ""
set -g status-right-length 200

#--- Catppuccin Init
set -g @catppuccin_flavor 'macchiato'
run '~/.config/tmux/plugins/catppuccin/tmux/catppuccin.tmux'
source -F "~/.config/tmux/modules/ram.conf"
source -F "~/.config/tmux/modules/docker.conf"

#--- Catppuccin Config
#-- Base
set -g @catppuccin_window_status_style "custom"
set -g @catppuccin_window_number_position "right"
set -g @catppuccin_window_current_number_color "#{@thm_red}"
set -g @catppuccin_status_background "#{@thm_crust}"
set -g @catppuccin_menu_selected_style "fg=#{@thm_surface_0},bg=#{@thm_yellow}"

#-- Windows
# Current window
set -g @catppuccin_window_current_left_separator "#[fg=#{@catppuccin_window_current_text_color},bg=#{@thm_crust}]"
set -g @catppuccin_window_current_middle_separator " #[fg=#{@catppuccin_window_current_number_color},bg=#{@catppuccin_window_current_text_color}]"
set -g @catppuccin_window_current_right_separator " #[fg=#{@catppuccin_window_current_number_color},bg=#{@thm_crust}]"

# Other windows
set -g @catppuccin_window_left_separator "#[fg=#{@catppuccin_window_text_color},bg=#{@thm_crust}]"
set -g @catppuccin_window_middle_separator " #[fg=#{@catppuccin_window_number_color},bg=#{@catppuccin_window_text_color}]"
set -g @catppuccin_window_right_separator " #[fg=#{@catppuccin_window_number_color},bg=#{@thm_crust}]"

# Windows Styling
set -g @catppuccin_window_text " #T"
set -g @catppuccin_window_number "#I"
set -g @catppuccin_window_current_text " #T"
set -g @catppuccin_window_current_number "#I"
set -g @catppuccin_window_flags "none" # none, icon, or text
set -g @catppuccin_window_flags_icon_last " 󰖰" # -
set -g @catppuccin_window_flags_icon_current " 󰖯" # *
set -g @catppuccin_window_flags_icon_zoom " 󰁌" # Z
set -g @catppuccin_window_flags_icon_mark " 󰃀" # M
set -g @catppuccin_window_flags_icon_silent " 󰂛" # ~
set -g @catppuccin_window_flags_icon_activity " 󱅫" # #
set -g @catppuccin_window_flags_icon_bell " 󰂞" # !
# Matches icon order when using `#F` (`#!~[*-]MZ`)
set -g @catppuccin_window_flags_icon_format "##{?window_activity_flag,#{E:@catppuccin_window_flags_icon_activity},}##{?window_bell_flag,#{E:@catppuccin_window_flags_icon_bell},}##{?window_silence_flag,#{E:@catppuccin_window_flags_icon_silent},}##{?window_active,#{E:@catppuccin_window_flags_icon_current},}##{?window_last_flag,#{E:@catppuccin_window_flags_icon_last},}##{?window_marked_flag,#{E:@catppuccin_window_flags_icon_mark},}##{?window_zoomed_flag,#{E:@catppuccin_window_flags_icon_zoom},} "

# Pane styling options
set -g @catppuccin_pane_status_enabled "yes"
set -g @catppuccin_pane_border_status "bottom"
set -g @catppuccin_pane_border_style "fg=#{@thm_overlay_0}"
set -g @catppuccin_pane_active_border_style "##{?pane_in_mode,fg=#{@thm_lavender},##{?pane_synchronized,fg=#{@thm_mauve},fg=#{@thm_lavender}}}"
set -g @catppuccin_pane_left_separator "█"
set -g @catppuccin_pane_middle_separator "█"
set -g @catppuccin_pane_right_separator "█"
set -g @catppuccin_pane_color "#{@thm_green}"
set -g @catppuccin_pane_background_color "#{@thm_surface_0}"
set -g @catppuccin_pane_default_text "##{pane_index}: ##{b:pane_current_path}"
set -g @catppuccin_pane_default_fill "number"
set -g @catppuccin_pane_number_position "left" # right, left

# Status line options
set -g @catppuccin_status_left_separator ""
set -g @catppuccin_status_middle_separator ""
set -g @catppuccin_status_right_separator "█"
set -g @catppuccin_status_connect_separator "yes" # yes, no
set -g @catppuccin_status_fill "icon"
set -g @catppuccin_status_module_bg_color "#{@thm_surface_0}"

#-- Modules
#- Session
set -g @catppuccin_status_session_icon_bg "#{@thm_green}"

#- CPU
set -g @catppuccin_status_cpu_icon_bg "#{@thm_blue}"
#set -g @catppuccin_status_cpu_text_bg "#{@thm_blue}"
#set -g @catppuccin_status_cpu_text_fg "#{@thm_crust}"

#- RAM
set -g @catppuccin_status_ram_icon_bg "#{@thm_blue}"

#- Load average
set -g @catppuccin_status_load_icon_bg "#{@thm_blue}"
{{- if eq .chezmoi.os "darwin" }}
set -g @catppuccin_load_text " #{l:#(uptime | sed 's/.*load averages*: //')}"
{{- else }}
set -g @catppuccin_load_text " #{l:#(cut -d' ' -f1-3 /proc/loadavg)}"
{{- end }}

#- Docker containers
set -g @catppuccin_status_docker_icon_bg "#{@thm_blue}"

#- Weather
set -g @catppuccin_status_weather_icon_bg "#{@thm_blue}"
set -g @tmux-weather-units "c"
set -g @tmux-weather-location "Berlin"
set -g @tmux-weather-format "+%m+%t"

#- Date / Time
set -g @catppuccin_status_date_time_icon_bg "#{@thm_blue}"
set -g @catppuccin_date_time_text " %H:%M"

# Cappuccin Modules
set -gF status-right "#{E:@catppuccin_status_session}"
set -agF status-right "#{E:@catppuccin_status_cpu}"
set -agF status-right "#{E:@catppuccin_status_ram}"
set -agF status-right "#{E:@catppuccin_status_load}"
set -agF status-right "#{E:@catppuccin_status_docker}"
set -agF status-right "#{E:@catppuccin_status_weather}"
set -agF status-right "#{E:@catppuccin_status_date_time}"


#--- Plugin Config
# tmux-vim
# Smart pane switching with awareness of Vim splits.
# decide whether we're in a Vim process
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"

bind-key -n 'M-Left' if-shell "$is_vim" 'send-keys M-Left' 'select-pane -L'
bind-key -n 'M-Down' if-shell "$is_vim" 'send-keys M-Down' 'select-pane -D'
bind-key -n 'M-Up' if-shell "$is_vim" 'send-keys M-Up' 'select-pane -U'
bind-key -n 'M-Right' if-shell "$is_vim" 'send-keys M-Right' 'select-pane -R'

tmux_version='$(tmux -V | sed -En "s/^tmux ([0-9]+(.[0-9]+)?).*/\1/p")'

if-shell -b '[ "$(echo "$tmux_version < 3.0" | bc)" = 1 ]' \
    "bind-key -n 'M-\\' if-shell \"$is_vim\" 'send-keys M-\\'  'select-pane -l'"
if-shell -b '[ "$(echo "$tmux_version >= 3.0" | bc)" = 1 ]' \
    "bind-key -n 'M-\\' if-shell \"$is_vim\" 'send-keys M-\\\\'  'select-pane -l'"

#bind-key -n 'A-Space' if-shell "$is_vim" 'send-keys A-Space' 'select-pane -t:.+'

bind-key -T copy-mode-vi 'M-Left' select-pane -L
bind-key -T copy-mode-vi 'M-Down' select-pane -D
bind-key -T copy-mode-vi 'M-Up' select-pane -U
bind-key -T copy-mode-vi 'M-Right' select-pane -R
# bind-key -T copy-mode-vi 'A-\\' select-pane -l
# bind-key -T copy-mode-vi 'A-space' select-pane -t:.+

# Jump to previous/next prompt with Ctrl+Up/Down
bind-key -n C-Up copy-mode \; send-keys -X search-backward "➜"
bind-key -n C-Down copy-mode \; send-keys -X search-forward "➜"

#--- Plugins (tpm; catppuccin v2.1.3 itself is pinned via chezmoi's .chezmoiexternal.toml)

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @treemux-tree-nvim-init-file '~/.config/tmux/treemux/configs/treemux_init.lua'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'xamut/tmux-weather'
set -g @plugin 'tmux-plugins/tmux-yank'
{{- if .work }}
set -g @plugin 'jonmosco/kube-tmux'
{{- end }}

run '~/.config/tmux/plugins/tpm/tpm'

set -g @tmux-autoreload-quiet 1
set-option -g @plugin 'b0o/tmux-autoreload'

#--- Pane border overrides (must be after TPM)
set -g pane-border-status top
set -g pane-border-format "#[align=left] #{pane_index}: #{?pane_title,#{pane_title},#{b:pane_current_path}} "
