{{- /* Installs the base toolset. Re-runs when the package list (hash below) changes.
       Linux: apt (Debian family) + a few GitHub-release binaries into ~/.local/bin.
       minimal tag: the shell/CLI set only (no build deps, no lazygit/nala, no bw/asdf, no import-ids cron).
       macOS: brew bundle on gui hosts. */ -}}
{{- $apt := list
      "zsh" "git" "curl" "wget" "unzip" "ca-certificates" "gnupg" "jq" "tmux" "openssh-client"
      "fzf" "eza" "bat" "zoxide" "git-delta" "ripgrep" "fd-find" "neovim" "tig"
      "htop" "btop" "ncdu" -}}
{{- if not (has "minimal" .tags) -}}
{{-   $apt = concat $apt (list "cron" "nala"
      "build-essential" "libssl-dev" "libyaml-dev" "zlib1g-dev" "libffi-dev" "libreadline-dev"
      "libbz2-dev" "libsqlite3-dev" "liblzma-dev" "libncurses-dev" "pkg-config") -}}
{{- end -}}
#!/bin/sh
# packages: {{ $apt | join " " | sha256sum }}
set -eu

log()  { printf '[packages] %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

BIN="$HOME/.local/bin"
mkdir -p "$BIN"

{{ if eq .chezmoi.os "linux" -}}
if ! have apt-get; then
  log "not a Debian-family system, skipping package install"
  exit 0
fi

if ! sudo -n true 2>/dev/null; then
  log "sudo needs a password here; run this yourself and re-apply:"
  log "  sudo apt-get install -y {{ $apt | join " " }}"
  exit 0
fi

export DEBIAN_FRONTEND=noninteractive

# gh from the official repo (Ubuntu's own package lags a year behind)
if [ ! -f /etc/apt/sources.list.d/github-cli.list ]; then
  log "adding the GitHub CLI apt repo"
  sudo mkdir -p -m 755 /etc/apt/keyrings
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
  sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
fi

log "apt-get update"
sudo apt-get update -qq

want="{{ $apt | join " " }} gh"
{{ if not (has "minimal" .tags) -}}
# Only ask for packages this release actually has (lazygit is not in 24.04, see below)
for p in lazygit; do
  if apt-cache show "$p" >/dev/null 2>&1; then want="$want $p"; fi
done
{{ end -}}
log "apt-get install"
# shellcheck disable=SC2086
sudo apt-get install -y -qq --no-install-recommends $want

# Debian/Ubuntu rename two binaries; give them their upstream names
have bat || { have batcat && ln -sf "$(command -v batcat)" "$BIN/bat"; }
have fd  || { have fdfind && ln -sf "$(command -v fdfind)" "$BIN/fd"; }

arch="$(uname -m)"
case "$arch" in
  x86_64) goarch=amd64 ;;
  aarch64|arm64) goarch=arm64 ;;
  *) goarch="$arch" ;;
esac

if ! have chezmoi; then
  log "installing chezmoi"
  sh -c "$(curl -fsSL https://get.chezmoi.io)" -- -b "$BIN"
fi

{{ if not (has "minimal" .tags) -}}
if ! have lazygit; then
  log "installing lazygit from GitHub releases"
  ver="$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest | jq -r '.tag_name | ltrimstr("v")')"
  lgarch="x86_64"; [ "$goarch" = arm64 ] && lgarch="arm64"
  curl -fsSL "https://github.com/jesseduffield/lazygit/releases/download/v${ver}/lazygit_${ver}_linux_${lgarch}.tar.gz" \
    | tar -xz -C "$BIN" lazygit
fi

if ! have bw; then
  log "installing the Bitwarden CLI"
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/bw.zip" "https://vault.bitwarden.com/download/?app=cli&platform=linux"
  unzip -oq "$tmp/bw.zip" -d "$tmp" && install -m 755 "$tmp/bw" "$BIN/bw"
  rm -rf "$tmp"
fi

if ! have asdf; then
  log "installing asdf"
  ver="$(curl -fsSL https://api.github.com/repos/asdf-vm/asdf/releases/latest | jq -r .tag_name)"
  curl -fsSL "https://github.com/asdf-vm/asdf/releases/download/${ver}/asdf-${ver}-linux-${goarch}.tar.gz" \
    | tar -xz -C "$BIN" asdf
fi

# Sync my GitHub keys into ~/.ssh/authorized_keys.github every 5 minutes, but only where sshd
# actually reads that file (AuthorizedKeysFile in sshd_config or a sshd_config.d drop-in)
sshd_reads_github_keys() {
  sudo -n sshd -T 2>/dev/null | grep -q 'authorized_keys\.github' && return 0
  grep -rqs 'authorized_keys\.github' /etc/ssh/sshd_config /etc/ssh/sshd_config.d 2>/dev/null
}
if ! crontab -l 2>/dev/null | grep -qF '.ssh/import-ids'; then
  if sshd_reads_github_keys; then
    log "adding the import-ids crontab entry"
    { crontab -l 2>/dev/null || true; echo "*/5 * * * * $HOME/.ssh/import-ids >> $HOME/.ssh/import-ids.log 2>&1"; } | crontab -
  else
    log "sshd does not read ~/.ssh/authorized_keys.github here, not adding the import-ids cron"
    log "  (add 'AuthorizedKeysFile .ssh/authorized_keys .ssh/authorized_keys.github' to sshd_config.d and re-apply)"
  fi
fi
{{ end -}}

{{ else if eq .chezmoi.os "darwin" -}}
if ! have brew; then
  log "Homebrew is missing: https://brew.sh — install it and re-apply"
  exit 0
fi
{{ if has "gui" .tags -}}
if [ -f "$HOME/Brewfile" ]; then
  log "brew bundle"
  brew bundle --file "$HOME/Brewfile" --no-upgrade
fi
{{ else -}}
log "no gui tag on macOS: installing the CLI basics only"
brew install zsh git curl tmux gnupg jq fzf eza bat zoxide git-delta ripgrep fd neovim lazygit tig htop btop ncdu chezmoi bitwarden-cli asdf gh
{{ end -}}
{{ end -}}
log "done"
