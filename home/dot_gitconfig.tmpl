# ~/.gitconfig — managed by chezmoi (`gitconfig`)
{{- /* Signing is on only where the secret key is in the keyring: after importing it on a host,
       `chezmoi apply` re-renders this file and turns gpgsign on. */ -}}
{{- $signing := false }}
{{- if lookPath "gpg" }}
{{-   $signing = eq (output "sh" "-c" "gpg --list-secret-keys 523CE7AD >/dev/null 2>&1 && echo yes || echo no" | trim) "yes" }}
{{- end }}
[user]
  name = Rojo
  email = rojo@rojo.dev
{{- if $signing }}
  signingkey = 523CE7AD

[commit]
  gpgsign = true

[gpg]
  program = gpg
{{- end }}

[core]
  excludesfile = ~/.gitignore
  quotepath = false
  editor = {{ if lookPath "nvim" }}nvim{{ else }}vim{{ end }}
  autocrlf = input
{{- if lookPath "delta" }}
  pager = delta

[interactive]
  diffFilter = delta --color-only
{{- end }}

[pull]
  rebase = true

[branch]
  autosetuprebase = always

[color]
  ui = true

[push]
  default = simple

[init]
  defaultBranch = main

[delta]
  dark = true
  line-numbers = false
  side-by-side = true
  navigate = true
{{- if lookPath "gh" }}

# What `gh auth setup-git` would write; kept here so chezmoi and gh don't fight over this file.
[credential "https://github.com"]
  helper =
  helper = !{{ lookPath "gh" }} auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !{{ lookPath "gh" }} auth git-credential
{{- end }}
