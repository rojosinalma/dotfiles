# External content pulled by chezmoi apply (refreshed weekly). Nothing vendored in the repo.

{{ if not (has "minimal" .tags) -}}
# git-radar for the prompt (the prompt degrades silently when it is absent; minimal skips it)
[".git-radar"]
    type = "git-repo"
    url = "https://github.com/michaeldfallen/git-radar.git"
    refreshPeriod = "168h"
{{- end }}

# Pinned catppuccin theme for tmux; the other plugins are installed by tpm (see .tmux.conf).
[".config/tmux/plugins/catppuccin/tmux"]
    type = "archive"
    url = "https://github.com/catppuccin/tmux/archive/refs/tags/v2.1.3.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
